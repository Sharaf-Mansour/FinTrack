{
  "name": "fintrack",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun run check && bun --bun vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "check": "bun --bun node_modules/svelte-check/bin/svelte-check --tsgo --tsconfig ./tsconfig.json && bun node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "bun test",
    "release": "bun test && bun run build && bun run verify:release",
    "verify:release": "bun scripts/verify-release.ts"
  },
  "dependencies": {
    "echarts": "6.1.x",
    "svelte": "latest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tailwindcss/vite": "latest",
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@latest",
    "fake-indexeddb": "latest",
    "svelte-check": "latest",
    "tailwindcss": "latest",
    "typescript": "^6.0.3",
    "vite": "latest",
    "vite-plugin-pwa": "latest"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "overrides": {
    "glob": "latest"
  }
}
